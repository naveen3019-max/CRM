{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "backend/src/**/*.js",
    "frontend/src/**/*.js",
    "frontend/src/**/*.jsx",
    "mobile/App.js",
    "mobile/app.config.js",
    "mobile/babel.config.js",
    "mobile/src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "backend/node_modules",
    "frontend/node_modules",
    "mobile/node_modules",
    "dist",
    "build",
    "coverage"
  ]
}
