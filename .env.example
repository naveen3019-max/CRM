# Database
MYSQL_PUBLIC_URL=mysql://root:your_railway_mysql_root_password@acela.proxy.rlwy.net:18132/railway
MYSQL_URL=mysql://root:your_railway_mysql_root_password@mysql.railway.internal:3306/railway
MYSQL_ROOT_PASSWORD=your_railway_mysql_root_password
DB_HOST=acela.proxy.rlwy.net
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your_railway_mysql_root_password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=2000
DB_CONNECT_TIMEOUT_MS=10000

# App
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_strong_secret
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
ALLOW_START_WITHOUT_DB=false

# PM2 / runtime
WEB_CONCURRENCY=1
