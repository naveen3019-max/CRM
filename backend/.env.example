NODE_ENV=development
PORT=5000
# Comma-separated allowed origins. Supports wildcard patterns like https://*.vercel.app
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=8h
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
MYSQL_PUBLIC_URL=mysql://root:your_railway_mysql_root_password@acela.proxy.rlwy.net:18132/railway
MYSQL_URL=mysql://root:your_railway_mysql_root_password@mysql.railway.internal:3306/railway
MYSQL_ROOT_PASSWORD=your_railway_mysql_root_password
DB_HOST=acela.proxy.rlwy.net
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your_railway_mysql_root_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
UPLOAD_DIR=uploads
