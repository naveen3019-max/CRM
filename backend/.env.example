NODE_ENV=development
PORT=5000
# Comma-separated allowed origins. Supports wildcard patterns like https://*.vercel.app
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=8h
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
MYSQL_PUBLIC_URL=mysql://root:your_railway_mysql_root_password@metro.proxy.rlwy.net:22437/railway
DB_HOST=metro.proxy.rlwy.net
DB_PORT=22437
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your_railway_mysql_root_password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
UPLOAD_DIR=uploads
